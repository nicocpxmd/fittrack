CREATE DATABASE IF NOT EXISTS goals;
USE goals;

CREATE TABLE IF NOT EXISTS goals (
    id INT AUTO_INCREMENT PRIMARY KEY,
    user_id VARCHAR(255) NOT NULL,
    tipo_meta VARCHAR(100) NOT NULL,        -- debe coincidir con una clave de measurements, ej. weight_kg
    descripcion VARCHAR(255) NOT NULL,
    valor_objetivo DECIMAL(10,2) NOT NULL,
    fecha_limite DATE NOT NULL,

    -- NUEVO: estado de progreso, persistido cada vez que se consulta la meta (GET /goals/:id)
    valor_actual DECIMAL(10,2) DEFAULT 0,
    porcentaje_cumplimiento DECIMAL(5,2) DEFAULT 0,
    cumplida BOOLEAN DEFAULT FALSE,

    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP
);
