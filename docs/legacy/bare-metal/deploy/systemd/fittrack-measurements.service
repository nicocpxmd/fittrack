[Unit]
Description=FitTrack measurements
After=network-online.target 
Wants=network-online.target

[Service]
User=vagrant
WorkingDirectory=/home/vagrant/fittrack_taller/services/measurements
ExecStart=/home/vagrant/fittrack_taller/services/measurements/venv/bin/uvicorn main:app --host 0.0.0.0 --port 8001
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
