[Unit]
Description=FitTrack progress
After=network-online.target 
Wants=network-online.target

[Service]
User=vagrant
WorkingDirectory=/home/vagrant/fittrack_taller/services/progress
ExecStart=/home/vagrant/fittrack_taller/services/progress/venv/bin/uvicorn main:app --host 0.0.0.0 --port 8005
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
