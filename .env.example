# Variables del stack de Swarm. Copiar a .env y cambiar los valores.
POSTGRES_PASSWORD=changeme
DB_PASSWORD=changeme
SECRET_KEY=changeme

# Administrador que se crea (o promueve) al arrancar el servicio de usuarios.
# Usa un correo de dominio normal: el validador rechaza dominios reservados como .test.
ADMIN_EMAIL=admin@fittrack.com
ADMIN_PASSWORD=changeme
ADMIN_FULL_NAME=Administrador
